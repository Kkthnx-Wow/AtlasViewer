# The addon lives in the AtlasViewer subfolder. package-as names the zip folder,
# and move-folders lifts the subfolder's files into it, which is also how the
# packager finds AtlasViewer.toc for the game versions and the CurseForge id.
# Indent with spaces only, the packager refuses a leading tab.
package-as: AtlasViewer

move-folders:
    AtlasViewer/AtlasViewer: AtlasViewer

# No libraries, so there is no separate no-lib build.
enable-nolib-creation: no

# Repository furniture and developer tools that have no business inside the
# addon folder. The data updater stays out of the zip on purpose, players never
# need it and it should not reach thousands of machines.
ignore:
    - .github
    - .gitignore
    - .gitattributes
    - .pkgmeta
    - docs
    - tools
    - README.md
    - CHANGELOG.md

# LICENSE is not ignored, so the repo's own copy ships inside the addon folder.
# license-output is left out on purpose. It asks CurseForge for a license text
# and failed on the first dry run.

manual-changelog:
    filename: CHANGELOG.md
    markup-type: markdown
