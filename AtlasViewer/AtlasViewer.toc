# Core
Core\Namespace.lua
Core\Constants.lua
Core\Database.lua
Core\Widgets.lua
Core\Grid.lua

# Locales
Locales\enUS.lua

# Data (bundled texture->atlas map). One file per game type; the client loads only
# the matching one. Regenerate any of them with update_atlas_data.py. Era and
# Anniversary share the vanilla type. A game type with no data falls back to
# reading the atlas list from the client (C_Texture.GetAtlasElements).
# The tag takes no colon. Mainline also excludes camelot so Forever never parses
# the retail file on top of its own.
Data\Data_Mainline.lua [AllowLoadGameType mainline][ExcludeLoadGameType camelot]
Data\Data_Vanilla.lua [AllowLoadGameType vanilla]
Data\Data_Mists.lua [AllowLoadGameType mists]
# WoW Forever reports game type camelot (spelled as Blizzard's own TOCs spell it).
Data\Data_Forever.lua [AllowLoadGameType camelot]

# Modules (Window first, it creates the Viewer table the others extend)
Modules\Window.lua
Modules\Gallery.lua
Modules\Detail.lua
Modules\Sheet.lua

# Boot
Core\Init.lua
